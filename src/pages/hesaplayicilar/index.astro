---
import AppLayout from "@/layouts/app-layout.astro";
import PageHeader from "@/components/common/page-header.vue";
import Breadcrumbs from "@/components/common/breadcrumbs.vue";
import Heading1 from "@/components/common/heading-1.vue";
import CalculatorsGrid from "@/components/calculators-grid.vue";
import BannerAd from "@/components/ad-banner.astro";

import { HesaplayicilarPageDef } from "@/domains/hesaplayicilar/page-def.js";
import { getCalculatorPages } from "@/domains/hesaplayicilar/db.js";

const calculatorPages = getCalculatorPages();

const hesaplayicilarPage = HesaplayicilarPageDef({
    schema: {
        items: calculatorPages
    }
});
---

<AppLayout page={hesaplayicilarPage}>
    <PageHeader>
        <div class="container">
            <Breadcrumbs
                items={hesaplayicilarPage.breadcrumbs}
                client:load />
            <Heading1>
                {hesaplayicilarPage.title}
            </Heading1>
        </div>
    </PageHeader>

    <div class="container">
        <BannerAd isFirst={true} />

        <CalculatorsGrid
            items={calculatorPages}
            titleTag="h2" />

        <BannerAd isLast={true} />
    </div>
</AppLayout>

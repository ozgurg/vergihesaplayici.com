---
import AppLayout from "@/layouts/app-layout.astro";
import PageHeader from "@/components/common/page-header.vue";
import Heading1 from "@/components/common/heading-1.vue";
import OsitaIhemeVideo from "@/components/osita-iheme-video.vue";
import Heading2 from "@/components/common/heading-2.vue";
import CalculatorsGrid from "@/components/calculators-grid.vue";
import UtilitiesGrid from "@/components/utilities-grid.vue";
import ArticlesGrid from "@/components/articles-grid.vue";
import BannerAd from "@/components/ad-banner.astro";

import { AnaSayfaPageDef } from "@/domains/ana-sayfa/page-def.js";
import { HesaplayicilarPageDef } from "@/domains/hesaplayicilar/page-def.js";
import { AraclarPageDef } from "@/domains/araclar/page-def.js";
import { YazilarPageDef } from "@/domains/yazilar/page-def.js";
import { getYazilar } from "@/domains/yazilar/db.js";
import { getCalculatorPages } from "@/domains/hesaplayicilar/db.js";
import { getUtilityPages } from "@/domains/araclar/db.js";

const anaSayfaPage = AnaSayfaPageDef();
const hesaplayicilarPage = HesaplayicilarPageDef();
const araclarPage = AraclarPageDef();
const yazilarPage = YazilarPageDef();

const calculatorPages = getCalculatorPages();
const utilityPages = getUtilityPages();
const yazilar = (await getYazilar()).slice(0, 8);
---

<AppLayout page={anaSayfaPage}>
    <section class="hero">
        <PageHeader>
            <div class="container">
                <div>
                    <Heading1>
                        Vergi Hesaplayıcı
                    </Heading1>
                    <div class="rich-text">
                        <p>vergihesaplayici.com, vergi hesaplar.</p>
                    </div>
                </div>
                <OsitaIhemeVideo client:idle />
            </div>
        </PageHeader>
    </section>
    <hr />

    <BannerAd inContainer={true} isFirst={true} />

    <div class="container">
        <section>
            <Heading2 tag="h2">
                <a href={hesaplayicilarPage.url.href}>
                    {hesaplayicilarPage.title}
                </a>
            </Heading2>
            <CalculatorsGrid
                items={calculatorPages}
                titleTag="h3" />
        </section>

        <BannerAd isFirst={true} isLast={true} />

        <section>
            <Heading2 tag="h2">
                <a href={araclarPage.url.href}>
                    {araclarPage.title}
                </a>
            </Heading2>
            <UtilitiesGrid
                items={utilityPages}
                titleTag="h3" />
        </section>

        <BannerAd isFirst={true} isLast={true} />

        <section>
            <Heading2 tag="h2">
                <a href={yazilarPage.url.href}>
                    {yazilarPage.title}
                </a>
            </Heading2>
            <ArticlesGrid
                titleTag="h3"
                items={yazilar} />
        </section>

        <BannerAd isLast={true} />
    </div>
</AppLayout>

<style lang="scss">
    .heading-1 {
        @include vh-media-breakpoint-down(md) {
            // I tried to keep the title in the same position across pages
            padding-block-start: calc(var(--breadcrumbs-block-size) + var(--breadcrumbs-margin-block-start))
        }
    }

    .page-header {
        padding-block-end: 0
    }

    .hero {
        .container {
            display: flex;
            gap: var(--vh-spacer);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            @include vh-media-breakpoint-up(md) {
                flex-direction: row;
                justify-content: space-between;
                align-items: center
            }
        }
        .rich-text {
            @include vh-media-breakpoint-up(md) {
                font-size: var(--vh-fs-md)
            }
        }
    }
</style>

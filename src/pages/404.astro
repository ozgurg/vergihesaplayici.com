---
import AppLayout from "@/layouts/app-layout.astro";
import PageHeader from "@/components/common/page-header.vue";
import Heading1 from "@/components/common/heading-1.vue";
import DwightSchruteVideo from "@/components/dwight-schrute-video.vue";
import TinyAdzBanner from "@/components/third-party/tinyadz-banner.astro";

import { AnaSayfaPageDef } from "@/domains/ana-sayfa/page-def.js";

const anaSayfaPage = AnaSayfaPageDef();
---

<AppLayout page={anaSayfaPage}>
    <PageHeader>
        <div class="container">
            <Heading1>
                Hata falan mı oldu, bir şey oldu sanki…
            </Heading1>
        </div>
    </PageHeader>

    <div class="container">
        <section
            class="rich-text text">
            <p>…ama bu aramızda kalabilir ¯\_(ツ)_/¯</p>
            <DwightSchruteVideo client:idle />

            <hr />

            <p><b><i>Ehem, biraz ciddiyet.</i> Şunları deneyebilirsiniz:</b></p>
            <ul>
                <li>Bağlantıyı yazım hatalarına karşı tekrar kontrol edin.</li>
                <li><a href={anaSayfaPage.url.href}>{anaSayfaPage.title}</a>'ya dönün ve oradan devam edin.</li>
                <li>Nerede yanlış yaptığınızı düşünün.</li>
            </ul>

            <TinyAdzBanner class="ta-ad-last" />
        </section>
    </div>
</AppLayout>

<style lang="scss">
    .heading-1 {
        padding-block-start: var(--breadcrumbs-block-size)
    }

    .text {
        @include vh-media-breakpoint-down(md) {
            text-align: center
        }
    }
</style>

<video
    autoplay=""
    loop=""
    muted=""
    playsinline=""
    aria-hidden="true"
    class="osita-iheme-video"
    width="184"
    height="184"
    preload="auto">
    <source
        src={staticUrl("/osita-iheme.mp4").href}
        type="video/mp4" />
</video>

<script>
    const video = document.querySelector(".osita-iheme-video") as HTMLVideoElement;
    if (video && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        video.autoplay = false;
        video.controls = true;
        video.pause();
    }
</script>

<style lang="scss" is:global>
    .osita-iheme-video {
        display: inline-block;
        overflow: hidden;
        @include vh-squircle(var(--vh-br-normal));
        background: hsla(var(--vh-clr-white-hsl), .08);
        aspect-ratio: 1/1
    }
</style>
